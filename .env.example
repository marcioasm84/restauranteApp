# Used by docker-compose.yml. Copy to .env and adjust before running in anything
# beyond local development.
POSTGRES_DB=mesaviva
POSTGRES_USER=mesaviva
POSTGRES_PASSWORD=mesaviva
JWT_SECRET=dev-secret-change-me

# Platform-level login (Super Admin) — manages clients, not scoped to any
# one of them. Each client's own admin/garçom/cozinha logins live in the
# database instead, created when the client is registered.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin123

# SMTP — e-mails a new client's admin/garçom/cozinha login when registered
# (and whenever credentials are resent/reset). Any standard SMTP account
# works (Gmail, SES, SendGrid, Postmark, Mailgun, your own server, ...).
# Leave SMTP_HOST empty for local dev — e-mails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Meu Restaurante <nao-responda@meurestaurante.app>"
PLATFORM_URL=http://localhost:8090

# Only read once, by server/scripts/migrate-to-multitenant.ts, to set the
# first client's ("Diferente D+") initial staff passwords.
ADMIN_PASSWORD=mesaviva123
WAITER_PASSWORD=garcom123
KITCHEN_PASSWORD=cozinha123
