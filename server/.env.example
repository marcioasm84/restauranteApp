# Used when running the backend directly with `npm run dev` (outside Docker),
# pointing at the Postgres/Redis containers started via `docker compose up
# postgres redis`. Copy to .env.
DATABASE_URL=postgresql://mesaviva:mesaviva@localhost:5433/mesaviva
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
PORT=4000

# Platform-level login (Super Admin) — manages clients, not scoped to any
# one of them. Each client's own admin/garçom/cozinha logins live in the
# database instead (created when the client is registered, see Super Admin
# area), not in env vars anymore.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin123

# SMTP — used to e-mail a new client's admin/garçom/cozinha login once the
# Super Admin registers them (and whenever credentials are resent/reset).
# Works with any standard SMTP account (Gmail, SES, SendGrid, Postmark,
# Mailgun, your own server, ...). Leave SMTP_HOST empty for local dev —
# e-mails are logged to the console instead of actually sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Meu Restaurante <nao-responda@meurestaurante.app>"
# Base URL the "acesse sua conta" link in that e-mail is built from —
# <slug> gets prepended as the subdomain.
PLATFORM_URL=http://localhost:8090

# Only read by scripts/migrate-to-multitenant.ts (one-off, Fase 6) to set
# the first client's ("Diferente D+") initial staff passwords.
ADMIN_PASSWORD=mesaviva123
WAITER_PASSWORD=garcom123
KITCHEN_PASSWORD=cozinha123
